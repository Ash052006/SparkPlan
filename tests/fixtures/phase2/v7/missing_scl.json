{
  "status": "ok",
  "title": "Soil moisture monitor",
  "summary": "Reads soil moisture and temperature, shows them on an OLED.",
  "parts": [
    {
      "instance_id": "board",
      "part_id": "esp32_devkit_30pin"
    },
    {
      "instance_id": "soil",
      "part_id": "soil_moisture_capacitive"
    },
    {
      "instance_id": "env",
      "part_id": "dht22"
    },
    {
      "instance_id": "screen",
      "part_id": "ssd1306_oled_096"
    }
  ],
  "connections": [
