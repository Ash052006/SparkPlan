# SparkPlan environment template. Copy to .env (git-ignored) and fill in.
# Never commit real keys.

# LLM provider: openai_compat (OpenAI-compatible) or groq, or fake.
SPARKPLAN_LLM_PROVIDER=openai_compat

# OpenAI-compatible base URL, e.g.:
#   OpenAI: https://api.openai.com/v1
#   Groq:   https://api.groq.com/openai/v1
SPARKPLAN_LLM_BASE_URL=

# API key for the chosen provider.
SPARKPLAN_LLM_API_KEY=

# Model name, e.g. gpt-4o-mini or llama-3.3-70b-versatile.
SPARKPLAN_LLM_MODEL=

# Optional: request timeout in seconds for the Phase 3 client (default 60).
SPARKPLAN_LLM_TIMEOUT_S=

# Optional: max completion tokens. Leave blank to omit the parameter.
SPARKPLAN_LLM_MAX_TOKENS=

# Optional: transport retries per LLM call (default 1). Separate from the
# planner's repair rounds. Raise this on providers with small TPM limits so a
# brief 429 does not end a plan.
SPARKPLAN_LLM_MAX_RETRIES=

# NOTE: the Phase 3 client requests structured output with a strict
# "json_schema" response_format and falls back to "json_object" once if a
# provider rejects the schema mode. Not every OpenAI-compatible provider
# implements both options; responses are always re-validated locally.

# Optional: path to arduino-cli if not on PATH.
SPARKPLAN_ARDUINO_CLI=

# Optional: override the catalog directory.
SPARKPLAN_CATALOG=
