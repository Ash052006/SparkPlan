# SparkPlan environment template. Copy to .env (git-ignored) and fill in.
# Never commit real keys.

# LLM provider: openai_compat (OpenAI-compatible) or groq, or fake.
SPARKPLAN_LLM_PROVIDER=openai_compat

# OpenAI-compatible base URL, e.g.:
#   OpenAI: https://api.openai.com/v1
#   Groq:   https://api.groq.com/openai/v1
SPARKPLAN_LLM_BASE_URL=

# API key for the chosen provider.
SPARKPLAN_LLM_API_KEY=

# Model name, e.g. gpt-4o-mini or llama-3.3-70b-versatile.
SPARKPLAN_LLM_MODEL=

# Optional: path to arduino-cli if not on PATH.
SPARKPLAN_ARDUINO_CLI=

# Optional: override the catalog directory.
SPARKPLAN_CATALOG=
