{
  "part_id": "ssd1306_oled",
  "name": "SSD1306 0.96 in OLED, 128x64, I2C",
  "category": "display",
  "description": "Monochrome 128x64 OLED over I2C at address 0x3C.",
  "supply": {
    "rail": "3v3",
    "voltage_min": 3.3,
    "voltage_max": 5.0,
    "i_ma_typ": 20,
    "i_ma_max": 25,
    "notes": "I2C address fixed at 0x3C on this module."
  },
  "pins": [
    {"name": "VCC", "kind": "power_in", "logic_v": 3.3},
    {"name": "GND", "kind": "ground", "logic_v": 0.0},
    {"name": "SCL", "kind": "i2c_scl", "logic_v": 3.3},
    {"name": "SDA", "kind": "i2c_sda", "logic_v": 3.3}
  ],
  "mechanical": {
    "width_mm": 27.0,
    "length_mm": 27.0,
    "height_mm": 4.5,
    "board_thickness_mm": 1.2,
    "mounting_holes": [
      {"x_mm": 1.5, "y_mm": 1.5, "diameter_mm": 2.0},
      {"x_mm": 25.5, "y_mm": 1.5, "diameter_mm": 2.0},
      {"x_mm": 1.5, "y_mm": 25.5, "diameter_mm": 2.0},
      {"x_mm": 25.5, "y_mm": 25.5, "diameter_mm": 2.0}
    ]
  },
  "firmware": {
    "libraries": ["Adafruit GFX Library", "Adafruit SSD1306"],
    "includes": ["#include <Wire.h>", "#include <Adafruit_GFX.h>", "#include <Adafruit_SSD1306.h>"],
    "defines": ["#define {instance}_SCREEN_W 128", "#define {instance}_SCREEN_H 64", "#define {instance}_I2C_ADDR 0x3C"],
    "i2c_address": "0x3C",
    "globals": ["static Adafruit_SSD1306 {instance}_display({instance}_SCREEN_W, {instance}_SCREEN_H, &Wire, -1);"],
    "setup": [
      "{instance}_display.begin(SSD1306_SWITCHCAPVCC, {instance}_I2C_ADDR);",
      "{instance}_display.clearDisplay();",
      "{instance}_display.setTextColor(SSD1306_WHITE);",
      "{instance}_display.setTextSize(1);",
      "{instance}_display.display();"
    ],
    "functions": [
      "void {instance}_print_line1(const char* text) {",
      "  {instance}_display.clearDisplay();",
      "  {instance}_display.setCursor(0, 0);",
      "  {instance}_display.println(text);",
      "  {instance}_display.display();",
      "}"
    ],
    "api": [
      {"name": "print_line1", "kind": "write", "returns": "void", "unit": "text", "param": "const char*", "fn": "{instance}_print_line1"}
    ]
  }
}
