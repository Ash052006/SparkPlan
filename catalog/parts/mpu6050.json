{
  "part_id": "mpu6050",
  "name": "MPU6050 6-axis accelerometer/gyroscope module (GY-521)",
  "category": "sensor",
  "description": "I2C accelerometer + gyroscope breakout with onboard 3.3V regulator; logic is 3.3V.",
  "supply": {
    "rail": "3v3",
    "voltage_min": 3.3,
    "voltage_max": 5.0,
    "i_ma_typ": 4,
    "i_ma_max": 10,
    "notes": "Breakout accepts 3.3-5V; onboard LDO feeds the die at 3.3V."
  },
  "pins": [
    {"name": "VCC", "kind": "power_in", "logic_v": 3.3},
    {"name": "GND", "kind": "ground", "logic_v": 0.0},
    {"name": "SCL", "kind": "i2c_scl", "logic_v": 3.3},
    {"name": "SDA", "kind": "i2c_sda", "logic_v": 3.3},
    {"name": "INT", "kind": "digital_out", "logic_v": 3.3}
  ],
  "mechanical": {
    "width_mm": 20.3,
    "length_mm": 15.7,
    "height_mm": 1.3,
    "board_thickness_mm": 1.3,
    "mounting_holes": []
  },
  "firmware": {
    "libraries": [],
    "includes": ["#include <Wire.h>"],
    "defines": ["#define {instance}_I2C_ADDR 0x68"],
    "i2c_address": "0x68",
    "globals": [],
    "setup": [
      "{instance}_write_reg(0x6B, 0x00);",
      "{instance}_write_reg(0x1A, 0x03);"
    ],
    "functions": [
      "static void {instance}_write_reg(uint8_t reg, uint8_t val) {",
      "  Wire.beginTransmission({instance}_I2C_ADDR);",
      "  Wire.write(reg); Wire.write(val); Wire.endTransmission();",
      "}",
      "float {instance}_read_accel_g() {",
      "  Wire.beginTransmission({instance}_I2C_ADDR);",
      "  Wire.write(0x3B); Wire.endTransmission(false);",
      "  Wire.requestFrom((uint8_t){instance}_I2C_ADDR, (uint8_t)6, true);",
      "  int16_t ax = (Wire.read() << 8) | Wire.read();",
      "  Wire.read(); Wire.read();",
      "  Wire.read(); Wire.read();",
      "  return (float)ax / 16384.0f;",
      "}",
      "float {instance}_read_gyro_dps() {",
      "  Wire.beginTransmission({instance}_I2C_ADDR);",
      "  Wire.write(0x43); Wire.endTransmission(false);",
      "  Wire.requestFrom((uint8_t){instance}_I2C_ADDR, (uint8_t)2, true);",
      "  int16_t gz = (Wire.read() << 8) | Wire.read();",
      "  return (float)gz / 131.0f;",
      "}"
    ],
    "api": [
      {"name": "read_accel_g", "kind": "read", "returns": "float", "unit": "g", "fn": "{instance}_read_accel_g"},
      {"name": "read_gyro_dps", "kind": "read", "returns": "float", "unit": "degrees_per_second", "fn": "{instance}_read_gyro_dps"}
    ]
  }
}
